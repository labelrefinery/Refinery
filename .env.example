# Copy to .env and fill in the token. .env is gitignored.
#
# Create the token at: Cloudflare dashboard -> R2 -> API -> Manage API tokens
# Permissions needed: "R2 Data Catalog" (read & write)
#                     "Object Read & Write" scoped to labelrefinery-datasets

R2_CATALOG_URI=https://catalog.cloudflarestorage.com/24828d2a24b818aa2e994213d8a562c6/labelrefinery-datasets
R2_WAREHOUSE=24828d2a24b818aa2e994213d8a562c6_labelrefinery-datasets
R2_CATALOG_TOKEN=
